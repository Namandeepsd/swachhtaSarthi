<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav_card"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Fixed Content Width to prevent shrinking in Editor -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="721dp"
            android:layout_height="wrap_content"
            android:minHeight="1501dp"
            tools:layout_width="721dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="62dp"
                android:layout_height="72dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="5dp"
                android:contentDescription="logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/logoswachhtasarthi" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="72dp"
                android:layout_height="29dp"
                android:layout_marginStart="66dp"
                android:layout_marginTop="16dp"
                android:text="Preeya"
                android:textSize="23sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="66dp"
                android:layout_marginTop="45dp"
                android:text="Gurugram"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="756dp"
                android:layout_height="315dp"
                android:layout_marginTop="70dp"
                android:contentDescription="cover"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/cover" />

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="124dp"
                android:layout_height="170dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="238dp"
                android:contentDescription="profile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/profile_image" />

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="125dp"
                android:layout_height="49dp"
                android:layout_marginStart="447dp"
                android:layout_marginTop="376dp"
                android:contentDescription="message"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/message" />

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="135dp"
                android:layout_height="80dp"
                android:layout_marginStart="551dp"
                android:layout_marginTop="364dp"
                android:contentDescription="follow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/follow" />

            <ImageView
                android:id="@+id/imageView8"
                android:layout_width="216dp"
                android:layout_height="49dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="396dp"
                android:contentDescription="username"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/user_name" />

            <TextView
                android:id="@+id/tvFollowerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="465dp"
                android:text="149"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvFollowerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="53dp"
                android:layout_marginTop="464dp"
                android:text=" Followers"
                android:textSize="21sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvScoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="163dp"
                android:layout_marginTop="464dp"
                android:text="Score:"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvScoreValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="224dp"
                android:layout_marginTop="464dp"
                android:text=" 900"
                android:textSize="21sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
