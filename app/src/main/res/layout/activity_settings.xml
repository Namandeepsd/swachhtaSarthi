<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_tray_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    app:srcCompat="@drawable/profile_image"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="2dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Namandeep Singh"
                        android:textColor="#1E293B"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Volunteer"
                        android:textColor="#64748B"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAccountProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="16dp"
                        android:padding="16dp"
                        android:text="Profile"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_myplaces" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/tvAccountNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="Notifications"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        app:drawableStartCompat="@android:drawable/ic_popup_reminder"
                        android:drawablePadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/tvAccountScoreMetrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="Score Metrics"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_sort_by_size"
                        android:drawablePadding="16dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReportProblem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="Report a Problem"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_report_image"
                        android:drawablePadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/tvMoreKnowMore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="Know More"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_info_details"
                        android:drawablePadding="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/tvLogout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="Logout"
                        android:textColor="#D32F2F"
                        android:textSize="16sp"
                        app:drawableStartCompat="@android:drawable/ic_lock_power_off"
                        android:drawablePadding="16dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/bottom_tray_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <include layout="@layout/component_tray_bottom" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>