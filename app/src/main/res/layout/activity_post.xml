<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- Header -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/back" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Post an Issue"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btnBack" />

            <!-- Image Picker Section -->
            <LinearLayout
                android:id="@+id/layoutImagePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@+id/btnBack">

                <!-- Initial Upload Box (visible when no images) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnUploadInitial"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/add"
                            app:tint="#135BEC" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Upload Images"
                            android:textColor="#135BEC"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thumbnails List (visible when images exist) -->
                <LinearLayout
                    android:id="@+id/layoutThumbnails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <!-- Thumbnail 1 -->
                    <FrameLayout
                        android:id="@+id/framePhoto1"
                        android:layout_width="86dp"
                        android:layout_height="86dp"
                        android:layout_marginEnd="12dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPhoto1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCorner8"
                            tools:src="@tools:sample/backgrounds/scenic" />
                        <ImageView
                            android:id="@+id/btnRemove1"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/rounded_blue_bg"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:padding="2dp"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <!-- Thumbnail 2 -->
                    <FrameLayout
                        android:id="@+id/framePhoto2"
                        android:layout_width="86dp"
                        android:layout_height="86dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPhoto2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCorner8" />
                        <ImageView
                            android:id="@+id/btnRemove2"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/rounded_blue_bg"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:padding="2dp"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <!-- Thumbnail 3 -->
                    <FrameLayout
                        android:id="@+id/framePhoto3"
                        android:layout_width="86dp"
                        android:layout_height="86dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPhoto3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCorner8" />
                        <ImageView
                            android:id="@+id/btnRemove3"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/rounded_blue_bg"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:padding="2dp"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <!-- Small Add Button (+) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAddMore"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#DDDDDD"
                        app:strokeWidth="1dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/add"
                            app:tint="#135BEC" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

            <!-- Location Section -->
            <TextView
                android:id="@+id/tvLocationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Location Details"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/btnBack"
                app:layout_constraintTop_toBottomOf="@+id/layoutImagePicker" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFetchGPS"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get GPS"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_mylocation"
                app:layout_constraintBottom_toBottomOf="@+id/tvLocationTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvLocationTitle" />

            <EditText
                android:id="@+id/etLatitude"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/border_grey"
                android:hint="Latitude"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@+id/etLongitude"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLocationTitle" />

            <EditText
                android:id="@+id/etLongitude"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/border_grey"
                android:hint="Longitude"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/etLatitude"
                app:layout_constraintTop_toTopOf="@+id/etLatitude" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoFillAddress"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-fill Address from GPS"
                android:textAllCaps="false"
                app:layout_constraintEnd_toEndOf="@+id/etLongitude"
                app:layout_constraintTop_toBottomOf="@+id/etLongitude" />

            <!-- Address Fields -->
            <EditText
                android:id="@+id/etAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/border_grey"
                android:hint="Street Address"
                android:inputType="textPostalAddress"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnAutoFillAddress" />

            <EditText
                android:id="@+id/etCity"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/border_grey"
                android:hint="City"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@+id/etPinCode"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etAddress" />

            <EditText
                android:id="@+id/etPinCode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/border_grey"
                android:hint="Pincode"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="0.6"
                app:layout_constraintStart_toEndOf="@+id/etCity"
                app:layout_constraintTop_toTopOf="@+id/etCity" />

            <!-- Date & Time Section -->
            <TextView
                android:id="@+id/tvDateTimeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Date &amp; Time"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/etCity"
                app:layout_constraintTop_toBottomOf="@+id/etCity" />

            <EditText
                android:id="@+id/etDateOfIssue"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/border_grey"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:focusable="false"
                android:hint="Select Date"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@+id/etTimeOfIssue"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDateTimeTitle" />

            <EditText
                android:id="@+id/etTimeOfIssue"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/border_grey"
                android:drawableEnd="@android:drawable/ic_menu_recent_history"
                android:focusable="false"
                android:hint="Select Time"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/etDateOfIssue"
                app:layout_constraintTop_toTopOf="@+id/etDateOfIssue" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescriptionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Detailed Description"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/etDateOfIssue"
                app:layout_constraintTop_toBottomOf="@+id/etDateOfIssue" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/border_grey"
                android:gravity="top|start"
                android:hint="Describe the issue here..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDescriptionTitle" />

            <!-- Submit Buttons -->
            <LinearLayout
                android:id="@+id/actionContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etDescription">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPostCommunity"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Report as community"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#135BEC"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPostIndividual"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Report individually"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>