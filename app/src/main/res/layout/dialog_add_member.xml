<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Invite Member"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Search registered users by email, name, or mobile number."
        android:textColor="#64748B"
        android:textSize="13sp" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etMemberSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@android:drawable/edit_text"
        android:hint="Type email / name / mobile"
        android:imeOptions="actionDone"
        android:inputType="textEmailAddress"
        android:padding="12dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8" />

    <TextView
        android:id="@+id/tvSelectedUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#EFF6FF"
        android:padding="10dp"
        android:textColor="#1D4ED8"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSearchHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/progressUsers"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMemberSuggestions"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp" />

</LinearLayout>
