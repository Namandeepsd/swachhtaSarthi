<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivNotificationIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#F1F5F9"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:srcCompat="@drawable/notification_icon" />

        <TextView
            android:id="@+id/tvNotificationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Community Invitation"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvNotificationTime"
            app:layout_constraintStart_toEndOf="@id/ivNotificationIcon"
            app:layout_constraintTop_toTopOf="@id/ivNotificationIcon" />

        <TextView
            android:id="@+id/tvNotificationMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:text="Your report has been resolved successfully."
            android:textColor="#334155"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/tvNotificationTime"
            app:layout_constraintStart_toEndOf="@id/ivNotificationIcon"
            app:layout_constraintTop_toBottomOf="@id/tvNotificationTitle" />

        <TextView
            android:id="@+id/tvNotificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3h ago"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tvNotificationMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvNotificationMessage" />

        <TextView
            android:id="@+id/tvNotificationReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:background="#F8FAFC"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="#475569"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivNotificationIcon"
            app:layout_constraintTop_toBottomOf="@id/tvNotificationMessage" />

        <LinearLayout
            android:id="@+id/layoutInviteActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivNotificationIcon"
            app:layout_constraintTop_toBottomOf="@id/tvNotificationReason">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptInvite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Accept"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:backgroundTint="#135BEC"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeclineInvite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Decline"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                android:textColor="#0F172A" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvInviteStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivNotificationIcon"
            app:layout_constraintTop_toBottomOf="@id/tvNotificationReason" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>