<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".config.ImageKitConfig"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwachhtaSarthi">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.pages.ReportDeepLinkActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="swachhtasarthi"
                    android:host="report" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.SignupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.ReportActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.CommunityActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.NotificationActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.FeedActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.CommunityUserDisplayActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.CommunityDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.CommunityContributionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.VolunteerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.SearchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.PeopleActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.RewardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.pages.MyReportsActivity"
            android:exported="false" />

        <service
            android:name=".service.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>